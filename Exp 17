        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import math\n",
        "print(\"\\nEXPERIMENT 17: FREQUENCY REUSE\")\n",
        "\n",
        "S = 420\n",
        "M = 10\n",
        "n = 4\n",
        "\n",
        "valid = sorted({\n",
        "    i*i + i*j + j*j\n",
        "    for i in range(5)\n",
        "    for j in range(5)\n",
        "} - {0})[:8]\n",
        "\n",
        "N_values = []\n",
        "SI_values = []\n",
        "\n",
        "print(\"N    D/R    Channels   Capacity   S/I(dB)\")\n",
        "\n",
        "for N in valid:\n",
        "    Q = math.sqrt(3*N)\n",
        "    k = S // N\n",
        "    C = M*k*N\n",
        "    si = (Q**n)/6\n",
        "    sidb = 10*math.log10(si)\n",
        "\n",
        "    N_values.append(N)\n",
        "    SI_values.append(sidb)\n",
        "\n",
        "    print(N, round(Q,3), k, C, round(sidb,2))\n",
        "\n",
        "for N, si in zip(N_values, SI_values):\n",
        "    if si >= 18:\n",
        "        print(\"\\nRequired cluster size:\", N)\n",
        "        break\n",
        "\n",
        "plt.figure()\n",
        "plt.plot(N_values, SI_values, marker='o')\n",
        "plt.axhline(18, linestyle='--')\n",
        "plt.xlabel(\"Cluster Size\")\n",
        "plt.ylabel(\"S/I (dB)\")\n",
        "plt.title(\"Experiment 17: S/I vs Cluster Size\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "plt.figure()\n",
        "plt.bar(N_values, [S//N for N in N_values])\n",
        "plt.xlabel(\"Cluster Size\")\n",
        "plt.ylabel(\"Channels per Cell\")\n",
        "plt.title(\"Experiment 17: Channels per Cell\")\n",
        "plt.grid()\n",
        "plt.show()\n"
      ]
